# Required
DISCORD_BOT_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
WEBSITE_INGESTION_ENDPOINT=https://your-proof-desk.example/api/ingest
INGESTION_SECRET=SET_THE_SAME_SECRET_AS_THE_WEBSITE

# Ticket panel destination. If TARGET_CHANNEL_ID is 0, /setup_tickets uses the channel where it is run.
TARGET_CHANNEL_ID=0
TICKET_CATEGORY_ID=0
TICKET_CATEGORY_NAME=YTB Tickets

# Discord role mapping
BLACKLIST_ROLE_ID=1559151386300518472
MEMBER_ROLE_ID=1555187430833786881

# Optional
FALLBACK_DIR=./fallback_logs
LOG_LEVEL=INFO

# Optional asset overrides
ICON_URL=https://media.discordapp.net/attachments/1540579548427583558/1555262609983414443/asdas.png?format=webp&quality=lossless&width=640&height=640
BANNER_URL=https://media.discordapp.net/attachments/1540579548427583558/1555262757065064519/bc12e32a-7d92-4a84-b19d-d0b0bb274d3e.png?format=webp&quality=lossless

# Optional HTTP health endpoint for hosted monitors
PORT=8080
